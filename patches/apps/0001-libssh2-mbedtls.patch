+void
+_libssh2_wincng_ecdsa_free(IN _libssh2_wincng_ecdsa_key *key)
+{
+    if(!key) {
+        return;
+    }
+
+    (void)BCryptDestroyKey(key->handle);
+    free(key);
+}
