+                ret = -1;
+                goto clean_exit;
+            }
+            _libssh2_sha_algo_value_hash(sha_algo_value, session,
+                                         exchange_state, &secret,
+                                         session->local.crypt->secret_len,
+                                         (const unsigned char *)"C");
