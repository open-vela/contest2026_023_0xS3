diff --git a/boards/xtensa/esp32s3/esp32s3-eye/src/esp32s3_board_ili9341.c b/boards/xtensa/esp32s3/esp32s3-eye/src/esp32s3_board_ili9341.c
new file mode 100644
index 00000000000..6236f5623f3
--- /dev/null
+++ b/boards/xtensa/esp32s3/esp32s3-eye/src/esp32s3_board_ili9341.c
@@ -0,0 +1,266 @@
+/****************************************************************************
+ * boards/xtensa/esp32s3/esp32s3-eye/src/esp32s3_board_ili9341.c
+ *
+ * ILI9341 (MSP2402 2.4" 240x320) 4-wire SPI panel for the N16R8 board.
+ *
+ * Wiring:
+ *   CS=GPIO10  DC=GPIO8  RST=GPIO9  MOSI=GPIO11  SCK=GPIO12  MISO=GPIO13
+ *   Backlight is tied to 3V3 on the module (always on).
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+/****************************************************************************
+ * Included Files
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <debug.h>
+#include <errno.h>
+
+#include <nuttx/arch.h>
+#include <nuttx/spi/spi.h>
+#include <nuttx/lcd/lcd.h>
+#include <nuttx/lcd/ili9341.h>
+
+#include <arch/board/board.h>
+
+#include "esp32s3_gpio.h"
+#include "esp32s3_spi.h"
+
+#ifdef CONFIG_ESP32S3_EYE_LCD_ILI9341
+
+/****************************************************************************
+ * Pre-processor Definitions
+ ****************************************************************************/
+
+#ifndef CONFIG_ESP32S3_EYE_ILI9341_DC
+#  define CONFIG_ESP32S3_EYE_ILI9341_DC 8
+#endif
+
+#ifndef CONFIG_ESP32S3_EYE_ILI9341_RESET
+#  define CONFIG_ESP32S3_EYE_ILI9341_RESET 9
+#endif
+
+#ifndef CONFIG_ESP32S3_EYE_ILI9341_FREQUENCY
+#  define CONFIG_ESP32S3_EYE_ILI9341_FREQUENCY 20000000
+#endif
+
+#define LCD_DC   CONFIG_ESP32S3_EYE_ILI9341_DC
+#define LCD_RST  CONFIG_ESP32S3_EYE_ILI9341_RESET
+#define LCD_FREQ CONFIG_ESP32S3_EYE_ILI9341_FREQUENCY
+
+#define LCD_SWAP_CHUNK 256
+
+/****************************************************************************
+ * Private Types
+ ****************************************************************************/
+
+struct lcd_init_cmd
+{
+  uint8_t cmd;
+  uint8_t len;
+  uint8_t data[15];
+};
+
+/****************************************************************************
+ * Private Data
+ ****************************************************************************/
+
+static FAR struct spi_dev_s *g_spi;
+static struct ili9341_lcd_s g_lcd;
+
+/* Panel power/timing/gamma settings from the LCDWIKI MSP2402 reference.
+ * MADCTL and pixel format are configured by the generic driver already.
+ */
+
+static const struct lcd_init_cmd g_panel_init[] =
+{
+  { 0xcf, 3, { 0x00, 0x81, 0x30 } },
+  { 0xed, 4, { 0x64, 0x03, 0x12, 0x81 } },
+  { 0xe8, 3, { 0x85, 0x10, 0x78 } },
+  { 0xcb, 5, { 0x39, 0x2c, 0x00, 0x34, 0x02 } },
+  { 0xf7, 1, { 0x20 } },
+  { 0xea, 2, { 0x00, 0x00 } },
+  { 0xc0, 1, { 0x21 } },
+  { 0xc1, 1, { 0x11 } },
+  { 0xc5, 2, { 0x3f, 0x3c } },
+  { 0xc7, 1, { 0xb5 } },
+  { 0xb1, 2, { 0x00, 0x1b } },
+  { 0x26, 1, { 0x01 } },
+  { 0xe0, 15, { 0x0f, 0x26, 0x24, 0x0b, 0x0e, 0x09, 0x54, 0xa8,
+                0x46, 0x0c, 0x17, 0x09, 0x0f, 0x07, 0x00 } },
+  { 0xe1, 15, { 0x00, 0x19, 0x1b, 0x04, 0x10, 0x07, 0x2a, 0x47,
+                0x39, 0x03, 0x06, 0x06, 0x30, 0x38, 0x0f } },
+};
+
+/****************************************************************************
+ * Private Functions
+ ****************************************************************************/
+
+static inline void lcd_dc(bool data)
+{
+  esp32s3_gpiowrite(LCD_DC, data);
+}
+
+static void lcd_select(FAR struct ili9341_lcd_s *lcd)
+{
+  SPI_LOCK(g_spi, true);
+  SPI_SELECT(g_spi, SPIDEV_DISPLAY(0), true);
+  SPI_SETMODE(g_spi, SPIDEV_MODE0);
+  SPI_SETBITS(g_spi, 8);
+  SPI_SETFREQUENCY(g_spi, LCD_FREQ);
+}
+
+static void lcd_deselect(FAR struct ili9341_lcd_s *lcd)
+{
+  SPI_SELECT(g_spi, SPIDEV_DISPLAY(0), false);
+  SPI_LOCK(g_spi, false);
+}
+
+static int lcd_sendcmd(FAR struct ili9341_lcd_s *lcd, const uint8_t cmd)
+{
+  lcd_dc(false);
+  SPI_SEND(g_spi, cmd);
+  return OK;
+}
+
+static int lcd_sendparam(FAR struct ili9341_lcd_s *lcd, const uint8_t param)
+{
+  lcd_dc(true);
+  SPI_SEND(g_spi, param);
+  return OK;
+}
+
+static int lcd_recvparam(FAR struct ili9341_lcd_s *lcd, FAR uint8_t *param)
+{
+  lcd_dc(true);
+  *param = (uint8_t)SPI_SEND(g_spi, 0xff);
+  return OK;
+}
+
+static int lcd_sendgram(FAR struct ili9341_lcd_s *lcd,
+                        FAR const uint16_t *wd, uint32_t nwords)
+{
+  static uint16_t swap[LCD_SWAP_CHUNK];
+  uint32_t n;
+  uint32_t i;
+
+  lcd_dc(true);
+
+  while (nwords > 0)
+    {
+      n = nwords > LCD_SWAP_CHUNK ? LCD_SWAP_CHUNK : nwords;
+      for (i = 0; i < n; i++)
+        {
+          swap[i] = (uint16_t)((wd[i] >> 8) | (wd[i] << 8));
+        }
+
+      SPI_SNDBLOCK(g_spi, swap, n * 2);
+
+      wd     += n;
+      nwords -= n;
+    }
+
+  return OK;
+}
+
+static int lcd_recvgram(FAR struct ili9341_lcd_s *lcd,
+                        FAR uint16_t *wd, uint32_t nwords)
+{
+  uint32_t i;
+
+  lcd_dc(true);
+  SPI_RECVBLOCK(g_spi, wd, nwords * 2);
+
+  for (i = 0; i < nwords; i++)
+    {
+      wd[i] = (uint16_t)((wd[i] >> 8) | (wd[i] << 8));
+    }
+
+  return OK;
+}
+
+static int lcd_backlight(FAR struct ili9341_lcd_s *lcd, int level)
+{
+  return OK;
+}
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: esp32s3_ili9341_lcdinitialize
+ *
+ * Description:
+ *   Initialize the ILI9341 panel on the board SPI bus and return the NuttX
+ *   lcd_dev_s instance.
+ *
+ ****************************************************************************/
+
+FAR struct lcd_dev_s *esp32s3_ili9341_lcdinitialize(
+    FAR struct spi_dev_s *spi)
+{
+  FAR struct lcd_dev_s *dev;
+  const struct lcd_init_cmd *c;
+  size_t i;
+  uint8_t n;
+
+  g_spi = spi;
+
+  g_lcd.select    = lcd_select;
+  g_lcd.deselect  = lcd_deselect;
+  g_lcd.sendcmd   = lcd_sendcmd;
+  g_lcd.sendparam = lcd_sendparam;
+  g_lcd.recvparam = lcd_recvparam;
+  g_lcd.sendgram  = lcd_sendgram;
+  g_lcd.recvgram  = lcd_recvgram;
+  g_lcd.backlight = lcd_backlight;
+
+  esp32s3_configgpio(LCD_DC, OUTPUT);
+  esp32s3_configgpio(LCD_RST, OUTPUT);
+
+  /* Hardware reset */
+
+  esp32s3_gpiowrite(LCD_RST, true);
+  up_mdelay(10);
+  esp32s3_gpiowrite(LCD_RST, false);
+  up_mdelay(20);
+  esp32s3_gpiowrite(LCD_RST, true);
+  up_mdelay(120);
+
+  dev = ili9341_initialize(&g_lcd, 0);
+  if (dev == NULL)
+    {
+      lcderr("ERROR: ili9341_initialize() failed\n");
+      return NULL;
+    }
+
+  /* Apply the panel specific power/timing/gamma table */
+
+  lcd_select(&g_lcd);
+  for (i = 0; i < sizeof(g_panel_init) / sizeof(g_panel_init[0]); i++)
+    {
+      c = &g_panel_init[i];
+      lcd_sendcmd(&g_lcd, c->cmd);
+      for (n = 0; n < c->len; n++)
+        {
+          lcd_sendparam(&g_lcd, c->data[n]);
+        }
+    }
+
+  lcd_deselect(&g_lcd);
+
+  /* Turn the display on */
+
+  dev->setpower(dev, 1);
+
+  lcdinfo("ILI9341 initialized\n");
+  return dev;
+}
+
+#endif /* CONFIG_ESP32S3_EYE_LCD_ILI9341 */
