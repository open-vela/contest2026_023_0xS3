+                                           LIBSSH2_SESSION *session,
+                                           const char *filedata,
+                                           size_t filedata_len,
+                                           unsigned const char *passphrase)
+{
+    int algorithm;
+    return _libssh2_sk_pub_openssh_keyfilememory(session,
+                                                 (void **)ed_ctx,
+                                                 "sk-ssh-ed25519@openssh.com",
+                                                 NULL,
+                                                 NULL,
+                                                 NULL,
+                                                 NULL,
+                                                 &algorithm,
+                                                 flags,
+                                                 application,
+                                                 key_handle,
+                                                 handle_len,
+                                                 filedata,
+                                                 filedata_len,
+                                                 passphrase);
+}
