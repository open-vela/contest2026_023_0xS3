+#include <unistd.h>
 
 #include <nuttx/arch.h>
+#include <nuttx/analog/adc.h>
+#include <nuttx/analog/ioctl.h>
 #include <nuttx/board.h>
 #include <nuttx/irq.h>
 
@@ -39,6 +43,12 @@
 
 #include "esp32s3-eye.h"
 
+#define BUTTON_MENU  (1U << 1)
+#define BUTTON_PLAY  (1U << 2)
+#define BUTTON_DOWN  (1U << 3)
+#define BUTTON_UP    (1U << 4)
+static int g_button_adc_fd = -1;
+
 /****************************************************************************
  * Public Functions
  ****************************************************************************/
@@ -57,7 +67,27 @@
 uint32_t board_button_initialize(void)
 {
   esp32s3_configgpio(BUTTON_BOOT, INPUT_FUNCTION_2 | PULLUP);
-  return 1;
+  g_button_adc_fd = open("/dev/adc0", O_RDONLY | O_NONBLOCK);
+  return 5;
+}
+
+static uint32_t board_adc_button(void)
+{
+  struct adc_msg_s message;
+  int32_t value;
+
+  if (g_button_adc_fd < 0 || ioctl(g_button_adc_fd, ANIOC_TRIGGER, 0) < 0 ||
+      read(g_button_adc_fd, &message, sizeof(message)) != sizeof(message))
+    {
+      return 0;
+    }
+
+  value = message.am_data;
+  if (value >= 2250 && value <= 2600) return BUTTON_MENU;
+  if (value >= 1700 && value <= 2200) return BUTTON_PLAY;
+  if (value >= 650 && value <= 1000) return BUTTON_DOWN;
+  if (value >= 200 && value <= 550) return BUTTON_UP;
+  return 0;
 }
 
 /****************************************************************************
@@ -110,6 +140,7 @@ uint32_t board_buttons(void)
     {
       ret = 0x1;
     }
+  ret |= board_adc_button();
 
   return ret;
 }
