+#ifdef CONFIG_EXAMPLES_VELAOPS
+#define VELAOPS_SETUP_GPIO 6
+
+static bool velaops_boot_button_held(int samples)
+{
+  bool value = true;
+  bool held = false;
+  int low_run = 0;
+  int fd;
+  int i;
+
+  esp32s3_configgpio(VELAOPS_SETUP_GPIO, INPUT_FUNCTION_2 | PULLUP);
+
+  fd = open("/dev/gpio1", O_RDONLY);
+
+  for (i = 0; i < samples; i++)
+    {
+      bool low = false;
+
+      if (fd >= 0)
+        {
+          value = true;
+          ioctl(fd, GPIOC_READ, (unsigned long)(uintptr_t)&value);
+
+          if (!value)
+            {
+              low = true;
+            }
+        }
+
+      if (!esp32s3_gpioread(VELAOPS_SETUP_GPIO))
+        {
+          low = true;
+        }
+
+      if (low)
+        {
+          low_run++;
+
+          if (low_run >= 2)
+            {
+              held = true;
+            }
+        }
+      else
+        {
+          low_run = 0;
+        }
+
+      usleep(200000);
+    }
+
+  if (fd >= 0)
+    {
+      close(fd);
+    }
+
+  return held;
+}
+
+static FAR void *velaops_boot_thread(FAR void *arg)
+{
+  if (velaops_boot_button_held(30))
+    {
+      printf("velaops: BOOT/OK held at startup, enter setup mode\n");
+      system("velaops boot setup");
+    }
+  else
+    {
+      system("velaops boot");
+    }
+
+  return NULL;
+}
+#endif
