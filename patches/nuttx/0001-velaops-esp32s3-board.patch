+/****************************************************************************
+ * Hardware self-test helpers
+ *
+ * The four keys, the status LED and the buzzer are driven directly.  On
+ * this board each extra /dev/gpio device registration disturbs the Wi-Fi
+ * data path (EAPOL exchange times out), so these pins must stay out of the
+ * generic GPIO driver.
+ ****************************************************************************/
+
+#define HWTEST_KEY_NUM     4
+#define HWTEST_LED_PIN     17
+#define HWTEST_BUZZER_PIN  16
+
+static const uint32_t g_hwtest_keys[HWTEST_KEY_NUM] =
+{
+  4, 5, 6, 7
+};
+
+static bool g_hwtest_ready;
+
+int board_hwtest_gpio_init(void)
+{
+  int i;
+
+  for (i = 0; i < HWTEST_KEY_NUM; i++)
+    {
+      esp32s3_configgpio(g_hwtest_keys[i], INPUT_FUNCTION_2 | PULLUP);
+    }
+
+  esp32s3_gpio_matrix_out(HWTEST_LED_PIN, SIG_GPIO_OUT_IDX, 0, 0);
+  esp32s3_configgpio(HWTEST_LED_PIN,
+                     OUTPUT_FUNCTION_2 | INPUT_FUNCTION_2);
+  esp32s3_gpiowrite(HWTEST_LED_PIN, false);
+
+  esp32s3_gpio_matrix_out(HWTEST_BUZZER_PIN, SIG_GPIO_OUT_IDX, 0, 0);
+  esp32s3_configgpio(HWTEST_BUZZER_PIN,
+                     OUTPUT_FUNCTION_2 | INPUT_FUNCTION_2);
+  esp32s3_gpiowrite(HWTEST_BUZZER_PIN, false);
+
+  g_hwtest_ready = true;
+  return OK;
+}
+
+int board_hwtest_gpio_read(int id)
+{
+  if (!g_hwtest_ready || id < 0 || id >= HWTEST_KEY_NUM)
+    {
+      return 1;
+    }
+
+  return esp32s3_gpioread(g_hwtest_keys[id]) ? 1 : 0;
+}
+
+void board_hwtest_gpio_write(int id, int value)
+{
+  if (!g_hwtest_ready)
+    {
+      return;
+    }
+
+  esp32s3_gpiowrite(id == 0 ? HWTEST_LED_PIN : HWTEST_BUZZER_PIN,
+                    value != 0);
+}
+
+void board_hwtest_key_drive(int id, int ms)
+{
+  if (!g_hwtest_ready || id < 0 || id >= HWTEST_KEY_NUM || ms <= 0)
+    {
+      return;
+    }
+
+  esp32s3_configgpio(g_hwtest_keys[id], OUTPUT_FUNCTION_2);
+  esp32s3_gpiowrite(g_hwtest_keys[id], false);
+  usleep((useconds_t)ms * 1000);
+  esp32s3_configgpio(g_hwtest_keys[id], INPUT_FUNCTION_2 | PULLUP);
+}
+
 #endif /* CONFIG_DEV_GPIO && !CONFIG_GPIO_LOWER_HALF */
