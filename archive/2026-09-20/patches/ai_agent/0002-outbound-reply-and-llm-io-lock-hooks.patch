@@ -322,6 +322,17 @@ static void quickapp_mq_dispatch(const char *chat_id, const char *content)
 
 /* ── Outbound dispatch ────────────────────────────────────────── */
 
+/* 队伍仓钩子：设备应用通过 agent_set_reply_hook 注册回调，把 Agent 回发
+ * 内容同步到 LCD 告警框并通知看板"诊断已完成"。未注册时为空操作，上游可独立
+ * 编译；用函数指针而非弱符号，避免弱实现满足引用后强实现不被链接。 */
+typedef void (*agent_reply_hook_t)(const char* channel, const char* content);
+static agent_reply_hook_t g_agent_reply_hook;
+
+void agent_set_reply_hook(agent_reply_hook_t hook)
+{
+    g_agent_reply_hook = hook;
+}
+
 /* ── Voice failure cooldown — prevent error-message cascade ──── */
 
 static volatile bool s_voice_cooldown;
