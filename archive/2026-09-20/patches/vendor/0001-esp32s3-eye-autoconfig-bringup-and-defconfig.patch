diff --git a/boards/esp32s3/esp32s3-eye/src/esp32s3_bringup.c b/boards/esp32s3/esp32s3-eye/src/esp32s3_bringup.c
index 1fb0404..278bc79 100644
--- a/boards/esp32s3/esp32s3-eye/src/esp32s3_bringup.c
+++ b/boards/esp32s3/esp32s3-eye/src/esp32s3_bringup.c
@@ -38,6 +38,7 @@
 #include <stdio.h>
 
 #include <errno.h>
+#include <spawn.h>
 #include <nuttx/fs/fs.h>
 
 #ifdef CONFIG_ESP32S3_TIMER
@@ -145,6 +146,13 @@ int esp32s3_bringup(void)
       syslog(LOG_ERR, "ERROR: Failed to mount tmpfs at %s: %d\n",
              CONFIG_LIBC_TMPDIR, ret);
     }
+
+  /* 为 VelaOps 私密配置提供独立的运行时文件系统。 */
+  ret = nx_mount(NULL, "/data", "tmpfs", 0, NULL);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "ERROR: Failed to mount tmpfs at /data: %d\n", ret);
+    }
 #endif
 
 #ifdef CONFIG_ESP32S3_TIMER
@@ -282,6 +290,43 @@ int esp32s3_bringup(void)
     {
       syslog(LOG_ERR, "ERROR: Failed to initialize SDMMC: %d\n", ret);
     }
+
+  /* VelaOps 参赛项目：上电拉起 TF 卡凭据自动配置（幂等；失败只打印，
+   * 不影响 NSH 手动配置流程）。
+   * 注意 1：CONFIG_LIBC_EXECFUNCS 未开启，按名查找不可用，直传 builtin 入口。
+   * 注意 2：task_setup 会把任务名自动放进 argv[0]，这里只传子命令。
+   * 注意 3：task_spawn 直传入口只用 CONFIG_POSIX_SPAWN_DEFAULT_STACKSIZE
+   * (2KB) 小栈，会栈溢出破坏堆（实测拖死 wifi 内核线程），必须走队伍仓的
+   * 显式指定栈启动入口。 */
+  {
+    extern int velaops_main(int argc, char *argv[]);
+    extern int velaops_spawn_with_stack(int (*entry)(int, char **),
+                                        const char *name, char *const argv[],
+                                        size_t stacksize);
+
+    static char *const velaops_autoconfig_argv[] =
+    {
+      "autoconfig", NULL
+    };
+
+    int velaops_spawn_pid;
+
+    syslog(LOG_INFO, "velaops: bringup spawning autoconfig\n");
+    velaops_spawn_pid = velaops_spawn_with_stack(velaops_main, "velaops",
+                                                 velaops_autoconfig_argv,
+                                                 32768);
+    if (velaops_spawn_pid < 0)
+      {
+        syslog(LOG_WARNING,
+               "velaops autoconfig spawn failed (%d), fallback to manual "
+               "setup\n", velaops_spawn_pid);
+      }
+    else
+      {
+        syslog(LOG_INFO, "velaops: autoconfig spawned pid=%d\n",
+               velaops_spawn_pid);
+      }
+  }
 #endif
 
 #ifdef CONFIG_ESP32S3_CAM
