config LVX_USE_DEMO_CONTEST2026_023_VELAOPS_SMOKE
	bool "VelaOps Sentinel board and stack smoke test"
	default n
	---help---
		Enable the contest2026_023_0xS3 hardware and software stack
		smoke test command: velaops_smoke.

config LVX_USE_DEMO_CONTEST2026_023_VELAOPS
	bool "VelaOps Sentinel SSH dashboard"
	default n
	select LIB_SSH
	select CRYPTO_MBEDTLS
	select ALLOW_GPL_COMPONENTS
	---help---
		Enable the layered VelaOps SSH monitoring command: velaops.
		Uses libssh with mbedTLS for SSH connectivity and AES-256-GCM
		encrypted credential vault.
