# 本地编辑器与 Python 缓存
__pycache__/
*.py[cod]
.vscode/
.idea/
.venv/
.pytest_cache/

# 本地构建和临时文件；AI Coding 日志不得忽略
build/
dist/
*.tmp
*.bak
*.swp
.velaops.local.env

# NuttX 通过应用软链接构建时生成在队伍仓内的中间文件
app/hello_app/.built
app/hello_app/.depend
app/hello_app/Make.dep

# 主机侧单测二进制（make 生成）
app/hello_app/tests/test_*
!app/hello_app/tests/test_*.c
!app/hello_app/tests/test_*.py
app/hello_app/*.o
app/hello_app/**/*.o

# VelaOps app build artifacts
app/velaops/*.o
app/velaops/**/*.o
app/velaops/.built
app/velaops/.depend
app/velaops/Make.dep
